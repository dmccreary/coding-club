{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Challenge Card",
  "type": "object",
  "required": ["card_id", "title", "track", "chapter", "front", "back", "status"],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "card_id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "title": { "type": "string", "minLength": 1, "maxLength": 60 },
    "track": { "type": "string", "enum": ["beginner", "intermediate", "advanced"] },
    "difficulty_color": { "type": "string", "enum": ["green", "blue", "black"] },
    "chapter": { "type": "string" },
    "concept_ids": { "type": "array", "items": { "type": "integer" } },
    "concept_labels": { "type": "array", "items": { "type": "string" } },
    "concept_tag": { "type": "string", "maxLength": 30 },
    "kit_required": { "type": ["string", "null"] },
    "materials": { "type": "array", "items": { "type": "string" } },
    "front": {
      "type": "object",
      "required": ["description", "steps"],
      "properties": {
        "icon": { "type": ["string", "null"] },
        "description": { "type": "string", "maxLength": 400 },
        "steps": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "stretch_goal": { "type": ["string", "null"] }
      }
    },
    "back": {
      "type": "object",
      "required": ["hints", "solution_type", "solution_steps"],
      "properties": {
        "hints": { "type": "array", "items": { "type": "string" }, "minItems": 1, "maxItems": 4 },
        "solution_type": { "type": "string", "enum": ["code", "circuit", "other"] },
        "solution_language": { "type": ["string", "null"], "enum": ["python", "micropython", "scratch", null] },
        "solution_steps": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "solution_code": { "type": ["string", "null"] },
        "solution_circuit_description": { "type": ["string", "null"] },
        "see_also": { "type": ["string", "null"] }
      }
    },
    "verification": {
      "type": "object",
      "properties": {
        "status": { "type": "string", "enum": ["unverified", "passed", "failed", "not_applicable"] },
        "method": { "type": ["string", "null"] },
        "last_run": { "type": ["string", "null"] },
        "notes": { "type": ["string", "null"] }
      }
    },
    "status": { "type": "string", "enum": ["drafted", "rendered", "proofed", "final"] },
    "reading_level_target": { "type": ["integer", "null"] },
    "print": {
      "type": "object",
      "properties": {
        "copies_recommended": { "type": "integer" },
        "theme": { "type": "string" }
      }
    },
    "author": { "type": "string" },
    "generated_by": { "type": "string" },
    "date_created": { "type": "string" },
    "date_modified": { "type": "string" }
  }
}
